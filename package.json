  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start -c --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir /tmp/akademika-sdk54-export",
    "start:clear": "expo start -c",
    "start:lan": "expo start -c --lan",
    "manual:validate": "node scripts/validateManualContent.js",
    "manual:generate-assets": "node scripts/generateManualAssetRegistry.js",
    "manual:prepare": "npm run manual:validate && npm run manual:generate-assets",
    "catalog:validate": "node scripts/validateCatalogContent.js",
    "catalog:generate-assets": "node scripts/generateCatalogAssetRegistry.js",
    "catalog:prepare": "npm run catalog:validate && npm run catalog:generate-assets",
    "content:prepare": "npm run manual:prepare && npm run catalog:prepare"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "node": "^26.4.0"
